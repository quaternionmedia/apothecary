# Node modules (for the JSCAD viewer and the fractal viewer's 3D library).
# The tree is a build artifact; the lockfile is not -- it is what makes
# `npm install` reproduce the same versions, and the house-stack record
# requires it committed alongside the dependencies it pins.
node_modules/

# Build outputs
*.scad
*.jscad
*.jscad.js
*.stl
!examples/*.scad
!examples/*.jscad
!examples/*.jscad.js
!parts/**/*.scad

# Playwright
playwright-report/
test-results/
playwright/.cache/

# Generated docs (screenshots, GIFs, raw video, rendered Markdown) --
# build artifacts of the E2E doc-workflow tests; regenerate with
# `apothecary docs generate`. Raw Playwright video is always ignored (even
# if this whole directory policy changes later).
docs/generated/
*.webm

# OS
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
*.tmp
*.bak
*.orig
*.params.json

# Scratch SCAD for on-demand node renders (written, rendered, removed)
.node-stl-*.scad

# Generated by the license-check workflow; uploaded as an artifact, never committed.
licenses.json
